---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Eric Ritchey',
  description = 'A foundry for notes, tools, and things worth a URL.',
} = Astro.props;

const pageTitle = title === 'Eric Ritchey' ? title : `${title} · Eric Ritchey`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/">ritchey.io</a>
        <nav class="nav" aria-label="Primary navigation">
          <a href="/articles/">Articles</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
