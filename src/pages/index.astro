---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { entryPath } from '../lib/content';

const pages = (await getCollection('pages', ({ data }) => data.draft !== true)).sort(
  (a, b) =>
    a.data.section.localeCompare(b.data.section) ||
    a.data.order - b.data.order ||
    a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout>
  <h1>Eric Ritchey</h1>
  <p class="intro">A foundry for notes, tools, and things worth a URL.</p>

  <ul class="links">
    <li><a href="/articles/">Articles</a></li>
    {
      pages.map((page) => (
        <li>
          <a href={`/${entryPath(page)}/`}>{page.data.title}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
