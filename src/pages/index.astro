---
import { getCollection } from 'astro:content';
import ContentCard from '../components/ContentCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { entryPath, formatDate, sortNewestFirst } from '../lib/content';

const articles = sortNewestFirst(
  await getCollection('articles', ({ data }) => data.draft !== true),
);
const latestArticle = articles[0];
const pages = (await getCollection('pages', ({ data }) => data.draft !== true)).sort(
  (a, b) =>
    a.data.section.localeCompare(b.data.section) ||
    a.data.order - b.data.order ||
    a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout>
  <section class="hero">
    <div>
      <p class="eyebrow">Personal playground</p>
      <h1>Make small things public.</h1>
      <p class="lede">
        A home for articles, notes, tools, collections, and whatever else wants
        a public URL. Some things will be polished. Some things will just be
        where the idea landed.
      </p>
    </div>
    <aside class="panel">
      <p class="eyebrow">Current shape</p>
      <p>
        Keep the blog-style writing at `/articles/`. Everything else can live at
        a path that matches the thing itself, like `/tools/tiny-tools/`.
      </p>
    </aside>
  </section>

  <section class="grid" aria-label="Site sections">
    <ContentCard
      eyebrow="Writing"
      href="/articles/"
      title="Articles"
      description="Longer notes, field reports, how-tos, and thoughts worth keeping."
    />
    {
      pages.map((page) => (
        <ContentCard
          eyebrow={page.data.section}
          href={`/${entryPath(page)}/`}
          title={page.data.title}
          description={page.data.description}
        />
      ))
    }
  </section>

  {
    latestArticle && (
      <section class="section panel">
        <p class="eyebrow">Latest article</p>
        <h2>{latestArticle.data.title}</h2>
        <p class="lede">{latestArticle.data.description}</p>
        <p class="meta">{formatDate(latestArticle.data.pubDate)}</p>
        <a href={`/articles/${entryPath(latestArticle)}/`}>Read the latest</a>
      </section>
    )
  }
</BaseLayout>
